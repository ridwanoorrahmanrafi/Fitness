# ==============================================================================
# ARISE: The System — Environment Configuration Template
# Copy this file to .env.local and populate with your secure project credentials.
# NEVER commit .env, .env.local, or actual secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Base URLs
# ------------------------------------------------------------------------------
NODE_ENV=development
# For local dev: http://localhost:3000
# For production: https://your-domain.vercel.app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Better Auth Configuration
# Generate a secure 32+ character key with: openssl rand -base64 32
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=your_super_secret_better_auth_key_min_32_chars_long_here
# Optional: Better Auth Infra Plugin Key (if using dash / sentinel cloud monitoring)
BETTER_AUTH_API_KEY=ba_your_optional_infra_api_key

# ------------------------------------------------------------------------------
# 3. MongoDB Cloud Database Connection (Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.your_cluster.mongodb.net/fitness?retryWrites=true&w=majority
MONGODB_DB_NAME=fitness
DATABASE_URL=mongodb+srv://db_user:db_password@cluster0.your_cluster.mongodb.net/fitness?retryWrites=true&w=majority
# Optional direct replica set connection
DIRECT_URL=mongodb://db_user:db_password@ac-node-00.mongodb.net:27017,ac-node-01.mongodb.net:27017,ac-node-02.mongodb.net:27017/fitness?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 4. AI Intelligence Providers (Biomechanical Coach & Nutrition Engine)
# Fallback order: Google Gemini -> OpenAI ChatGPT -> Deterministic Sports Science Engine
# ------------------------------------------------------------------------------
# Primary Coach: Google Gemini (Get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary AI Reviewer: OpenAI (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# ACCESS_CODE: If defined, requires visitors to enter this PIN/Passcode to generate AI workouts
# ACCESS_CODE=choose_a_strong_access_passcode

# Upstash Redis: For distributed multi-region rate limiting on serverless edge
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
