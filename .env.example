# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override models. Defaults use Google's "latest" aliases so a retired model name can't break the app.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Optional but recommended once deployed: a code you type once in the app (Settings).
# Without it, anyone who finds your URL can spend your free quota.
# ACCESS_CODE=choose-something-long
